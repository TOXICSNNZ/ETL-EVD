          SQLTask:Connection="{72A1C672-3598-41E1-9899-ECA794D26A3D}"
          SQLTask:SqlStatementSource="DECLARE @json NVARCHAR(MAX) =&#xA;  (SELECT BulkColumn FROM OPENROWSET(BULK 'C:\ETL\fuentes\clientes.json', SINGLE_NCLOB) AS j);&#xA;&#xA;INSERT INTO dbo.bronze_clientes (id, nombre, edad, ciudad)&#xA;SELECT id, nombre, edad, ciudad&#xA;FROM OPENJSON(@json) WITH (&#xA;    id     NVARCHAR(50)  '$.id',&#xA;    nombre NVARCHAR(150) '$.nombre',&#xA;    edad   NVARCHAR(50)  '$.edad',&#xA;    ciudad NVARCHAR(100) '$.ciudad');" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
