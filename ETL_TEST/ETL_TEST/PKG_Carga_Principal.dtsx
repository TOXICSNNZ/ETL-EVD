      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{72A1C672-3598-41E1-9899-ECA794D26A3D}"
          SQLTask:SqlStatementSource="UPDATE l SET&#xA;    fecha_fin = GETDATE(),&#xA;    estado = 'EXITOSO',&#xA;    filas_extraidas  = (SELECT COUNT(*) FROM dbo.bronze_ventas),&#xA;    filas_cargadas   = (SELECT COUNT(*) FROM dbo.fact_ventas_staging),&#xA;    filas_rechazadas = (SELECT COUNT(*) FROM dbo.tabla_rechazos r&#xA;                        WHERE r.origen = 'ventas.csv' AND r.fecha_proceso &gt;= l.fecha_inicio)&#xA;FROM dbo.etl_log_ejecucion l&#xA;WHERE l.log_id = ?;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
